<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SAS.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SAS">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <AcrylicBrush x:Key="SettingsSurfaceBrush" TintColor="#EEF8FC" TintOpacity="0.18" TintLuminosityOpacity="0.82" FallbackColor="#EEF8FC" />
            <AcrylicBrush x:Key="SettingsNavBrush" TintColor="#EAF5FA" TintOpacity="0.42" TintLuminosityOpacity="0.80" FallbackColor="#EAF5FA" />
            <SolidColorBrush x:Key="SettingsNavSelectedBrush" Color="#DDECF3" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#FAFDFF" />
            <SolidColorBrush x:Key="SettingsDividerBrush" Color="#DDE8EE" />
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SettingsDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>



