<Window
    x:Class="SAS.Views.JabilEyeReconnectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="ReconnectRoot"
        Width="420"
        MinHeight="244"
        Padding="1"
        Background="Transparent">
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Padding="24" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="#FFF4CE">
                        <FontIcon
                            x:Name="StateIcon"
                            Glyph="&#xE783;"
                            FontSize="22"
                            Foreground="#9D5D00" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            x:Name="TitleTextBlock"
                            Text="JabilEye disconnected"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="HostTextBlock"
                            Text="Please restart JabilEye."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="MessageTextBlock"
                    Grid.Row="1"
                    Text="SAS is locked and waiting for the camera connection to come back. The unlock camera will resume automatically after reconnect."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        x:Name="ReconnectProgressRing"
                        Width="24"
                        Height="24"
                        IsActive="True" />
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Grid.Column="1"
                        Text="Trying to reconnect..."
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <StackPanel
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Click="RetryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Retry" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ChangeHostnameButton" Click="ChangeHostnameButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <TextBlock x:Name="ChangeHostnameButtonText" Text="Change hostname" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DismissButton" Click="DismissButton_Click" Content="Dismiss" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
