<Window
    x:Class="SAS.Views.LockWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WidgetRoot" MinWidth="240" MinHeight="224" Background="Transparent">
        <Border
            Margin="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid RowDefinitions="172,52">
                <Border Background="Black" CornerRadius="12,12,0,0">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image
                            x:Name="PreviewImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="UniformToFill" />
                        <Canvas x:Name="FaceOverlayCanvas" IsHitTestVisible="False">
                            <Border
                                x:Name="FaceOverlayBorder"
                                Visibility="Collapsed"
                                BorderThickness="2"
                                CornerRadius="3"
                                Background="Transparent" />
                            <Border
                                x:Name="FaceOverlayLabelBorder"
                                Visibility="Collapsed"
                                CornerRadius="3"
                                Padding="4,2">
                                <TextBlock
                                    x:Name="FaceOverlayLabelTextBlock"
                                    Foreground="White"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </Canvas>
                        <TextBlock
                            x:Name="PreviewPlaceholder"
                            Text="Waiting for camera"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    MinHeight="52"
                    Padding="10,7"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE785;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="System locked" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="StatusTextBlock"
                                Text="Scan your face to unlock"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


