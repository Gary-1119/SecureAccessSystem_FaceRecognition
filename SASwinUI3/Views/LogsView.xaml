<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SAS.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="14">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="24" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Log" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Review SAS activity and download local app logs to this PC." Style="{StaticResource SmallLabelStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="LogsInfoBar" IsOpen="False" IsClosable="True" />
            <ProgressBar x:Name="LogsProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="SAS Log" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Windows app activity, page access, settings changes, registration, and transfers." Style="{StaticResource SmallLabelStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="DownloadSasLogButton_Click" ToolTipService.ToolTip="Download today's SAS log">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="SasLogPathTextBlock" Style="{StaticResource SmallLabelStyle}" TextWrapping="Wrap" />

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SasLogDestinationTextBox" Header="Download folder" PlaceholderText="C:\Temp or choose a folder" />
                        <Button Grid.Column="1" Click="BrowseSasLogFolderButton_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="Choose SAS log download folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="3" x:Name="LogsListView" SelectionMode="None" MaxHeight="390" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
